<section id="contacto" class="py-28 md:py-40 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <div class="mb-16 reveal">
      <span class="text-xs font-medium uppercase tracking-[0.3em] text-neutral-400 mb-6 block">Contacto</span>
      <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-[1.02] max-w-[900px]">
        Comienza aquí tu proyecto con nosotros.
      </h2>
      <p class="mt-6 text-lg text-neutral-500 max-w-[560px]">¡Nos encantaría saber de ti! Escríbenos y conversemos sobre cómo hacer realidad tu proyecto.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-12 md:gap-20">
      <!-- Info -->
      <div class="reveal reveal-delay-1 flex flex-col gap-8">
        <div class="flex flex-col gap-1">
          <span class="text-xs font-medium uppercase tracking-[0.3em] text-neutral-400">Teléfono</span>
          <a href="tel:+56930669996" class="text-lg font-medium hover:text-neutral-600 transition-colors">+56 9 3066 9996</a>
        </div>
        <div class="flex flex-col gap-1">
          <span class="text-xs font-medium uppercase tracking-[0.3em] text-neutral-400">Email</span>
          <a href="mailto:hola@accelerazione.cl" class="text-lg font-medium hover:text-neutral-600 transition-colors">hola@accelerazione.cl</a>
        </div>
        <div class="flex flex-col gap-1">
          <span class="text-xs font-medium uppercase tracking-[0.3em] text-neutral-400">Ubicación</span>
          <span class="text-lg font-medium">Santiago, Chile &amp; LATAM</span>
        </div>
        <div class="flex flex-col gap-3 pt-4">
          <span class="text-xs font-medium uppercase tracking-[0.3em] text-neutral-400">Síguenos</span>
          <div class="flex gap-4">
            <a href="#" class="text-sm font-medium link-underline">Instagram</a>
            <a href="#" class="text-sm font-medium link-underline">LinkedIn</a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="reveal reveal-delay-2">
        <form id="contactForm" action="https://formspree.io/f/mbdbpzlq" method="POST" class="flex flex-col gap-5">
          <input type="text" name="name" placeholder="Nombre y Apellido" required class="font-sans text-base px-0 py-4 border-b border-neutral-200 bg-transparent text-neutral-900 outline-none focus:border-neutral-900 transition-colors" />
          <input type="email" name="email" placeholder="Correo Electrónico" required class="font-sans text-base px-0 py-4 border-b border-neutral-200 bg-transparent text-neutral-900 outline-none focus:border-neutral-900 transition-colors" />
          <input type="text" name="company" placeholder="Empresa" required class="font-sans text-base px-0 py-4 border-b border-neutral-200 bg-transparent text-neutral-900 outline-none focus:border-neutral-900 transition-colors" />
          <select name="service" required class="font-sans text-base px-0 py-4 border-b border-neutral-200 bg-transparent text-neutral-900 outline-none focus:border-neutral-900 transition-colors">
            <option value="">¿Qué servicio te interesa?</option>
            <option value="audiovisual-integral">Producción Audiovisual Integral</option>
            <option value="consultoria">Consultoría</option>
            <option value="contenidos">Marketing de Contenidos</option>
            <option value="videojuegos">Marketing de Videojuegos</option>
            <option value="soluciones-ia">Soluciones IA</option>
          </select>
          <textarea name="message" rows="4" placeholder="Déjanos tu solicitud" required class="font-sans text-base px-0 py-4 border-b border-neutral-200 bg-transparent text-neutral-900 outline-none focus:border-neutral-900 transition-colors resize-y"></textarea>
          <button type="submit" class="mt-4 bg-black text-white hover:bg-neutral-800 px-8 py-4 rounded-full text-sm font-semibold self-start transition-all duration-300 hover:-translate-y-0.5">Enviar</button>
          <p class="text-xs text-neutral-400">Respondemos en menos de 24 hrs hábiles.</p>
        </form>
        <div id="formSuccess" class="text-left py-12 hidden">
          <h3 class="text-2xl font-bold text-neutral-900 mb-2">¡Gracias!</h3>
          <p class="text-sm text-neutral-500">Nos pondremos en contacto contigo pronto.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  const success = document.getElementById('formSuccess');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.textContent;
    btn.textContent = 'Enviando...';
    btn.disabled = true;
    try {
      const data = new FormData(form);
      const response = await fetch(form.action, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
      if (response.ok) { form.style.display = 'none'; success.hidden = false; }
      else { alert('Ocurrió un error al enviar el mensaje. Por favor, intenta de nuevo.'); }
    } catch { alert('Error de conexión. Por favor, verifica tu internet e intenta de nuevo.'); }
    finally { btn.textContent = originalText; btn.disabled = false; }
  });
</script>