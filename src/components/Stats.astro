---
interface Logo {
  id: string;
  ext: string;
}

const logos: Logo[] = [
  { id: "penguin-random-house", ext: "svg" },
  { id: "abc", ext: "png" },
  { id: "1mistore", ext: "png" },
  { id: "infinitiv-capital", ext: "webp" },
  { id: "trikawe-real-estate", ext: "png" },
  { id: "universidad-de-chile", ext: "svg" },
  { id: "uahc", ext: "svg" },
  { id: "procter-gamble", ext: "svg" },
  { id: "puig", ext: "svg" },
  { id: "toyotomi", ext: "png" },
  { id: "cassis-cafe", ext: "png" },
  { id: "uriage", ext: "svg" },
  { id: "singalore", ext: "png" },
  { id: "santander", ext: "svg" },
  { id: "perrier", ext: "svg" },
  { id: "glow", ext: "svg" },
  { id: "copec", ext: "svg" },
  { id: "compara-online", ext: "svg" },
  { id: "minera-tres-valles", ext: "png" },
  { id: "mutual-de-seguros-de-chile", ext: "png" },
  { id: "camara-chilena-construccion", ext: "svg" },
];
---

<section id="clientes" class="py-28 md:py-40 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <div class="mb-16 reveal">
      <span class="text-xs font-medium uppercase tracking-[0.3em] text-neutral-400 mb-6 block">Clientes</span>
      <h2 class="text-4xl md:text-6xl font-bold tracking-tighter leading-[1.02] max-w-[700px]">
        Empresas que confían en nosotros.
      </h2>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7 gap-x-8 gap-y-10 items-center">
      {logos.map((logo, i) => (
        <div class={`flex items-center justify-center reveal reveal-delay-${(i % 4) + 1}`}>
          <img
            src={`/logos/${logo.id}.${logo.ext}`}
            alt={logo.id}
            class={`logo-image${logo.id === 'trikawe-real-estate' || logo.id === 'cassis-cafe' ? ' logo-dark' : ''}${logo.id === 'abc' ? ' logo-abc' : ''}${logo.id === 'universidad-de-chile' ? ' logo-uchile' : ''}${logo.id === '1mistore' ? ' logo-1mi' : ''}`}
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .logo-image {
    height: 1.75rem;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.55;
    transition: filter 0.4s ease, opacity 0.4s ease;
  }
  .logo-image:hover { filter: grayscale(0%); opacity: 1; }
  .logo-image.logo-dark { filter: grayscale(100%) brightness(0); opacity: 0.55; }
  .logo-image.logo-dark:hover { filter: grayscale(0%) brightness(0); opacity: 0.85; }
  .logo-image.logo-abc { height: 3.5rem; }
  .logo-image.logo-uchile { height: 2.5rem; }
  .logo-image.logo-1mi { height: 2rem; }
</style>